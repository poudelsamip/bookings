// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ORGANIZER
  STAFF
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  phone        String?
  role         UserRole @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizer Organizer?

  orders Order[]

  @@map("users")
}

model Organizer {
  id String @id @default(uuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  orgName      String  @map("org_name")
  description  String?
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  website      String?
  logoUrl      String? @map("logo_url")

  events Event[]

  @@map("organizer")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id String @id @default(uuid())

  organizerId String    @map("organizer_id")
  organizer   Organizer @relation(fields: [organizerId], references: [id])

  categoryId String        @map("category_id")
  category   EventCategory @relation(fields: [categoryId], references: [id])

  venue Venue?

  title       String
  slug        String  @unique
  description String
  bannerUrl   String? @map("banner_url")

  date      DateTime  @db.Date
  startTime DateTime
  endTime   DateTime?

  seatingType SeatingType @map("seating_type")

  ticketTypes TicketType[]
  orders      Order[]
  tickets     Ticket[]

  status EventStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
  @@index([categoryId])
  @@index([status])
  @@index([date])
  @@map("event")
}

model EventCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_category")
}

model Venue {
  id String @id @default(uuid())

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name       String
  address    String
  district   String
  googleMaps String? @map("google_maps")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("venue")
}

enum SeatingType {
  GENERAL
  BLOCK
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentProvider {
  ESEWA
  KHALTI
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum TicketStatus {
  VALID
  CANCELLED
}

model TicketType {
  id String @id @default(uuid())

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  name  String
  price Int
  total Int
  held  Int    @default(0)
  sold  Int    @default(0)

  tickets    Ticket[]
  orderItems OrderItem[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("ticket_type")
}

model Order {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  total  Int // money
  status OrderStatus

  items    OrderItem[]
  tickets  Ticket[]
  payments Payment[] // incase of failures we store them also

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventId])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  ticketTypeId String     @map("ticket_type_id")
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  quantity  Int
  unitPrice Int @map("unit_price")

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
  @@map("order_items")
}

model Ticket {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  ticketTypeId String     @map("ticket_type_id")
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  qrCode String       @unique @map("qr_code")
  status TicketStatus @default(VALID)

  checkedInAt DateTime? @map("checked_in_at")

  seatId String? @map("seat_id")

  @@index([orderId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@map("tickets")
}

model Payment {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  provider      PaymentProvider @default(ESEWA)
  transactionId String?         @map("transaction_id")
  amount        Int // money
  status        PaymentStatus   @default(INITIATED)
  rawResponse   Json?           @map("raw_response") // to store payment provider raw response of transaction

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, transactionId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}
